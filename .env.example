# ==============================================================================
# !AI DIGITAL CHECK — TEMPLATE DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env.local e preencha suas credenciais reais.
# ==============================================================================

# 1. CONEXÃO POSTGRESQL (Supabase Transaction Pooler na porta 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# 2. CONTROLE DE SSL
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# 3. AMBIENTE DE EXECUÇÃO ('development' | 'production')
NODE_ENV=development

# 4. INTEGRAÇÕES OPCIONAIS
# CRM_WEBHOOK_URL=https://api.meucrm.com.br/webhook
# EMAIL_API_KEY=sua_chave_aqui
# INTERNAL_ALERT_EMAIL=contato@suaempresa.com.br
