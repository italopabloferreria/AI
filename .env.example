# ==============================================================================
# !AI — Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env.local e preencha seus valores reais.
# ==============================================================================

# BANCO DE DADOS (PostgreSQL)
# Obrigatório em produção para persistência do !AI Digital Check e Leads.
# Execute o schema em db/schema.sql antes de iniciar.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ai_database

# AMBIENTE DE EXECUÇÃO ('development' | 'production')
NODE_ENV=development

# INTEGRAÇÃO COM CRM (Opcional)
# CRM_WEBHOOK_URL=https://api.meucrm.com.br/webhook/digital-check

# NOTIFICAÇÕES E E-MAIL (Opcional)
# EMAIL_API_KEY=re_123456789
# INTERNAL_ALERT_EMAIL=contato@icantbelieveitsai.com
