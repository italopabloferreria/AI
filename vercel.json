{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/digital-check/:id/answers",
      "destination": "/api/_bridge?__route=/api/digital-check/:id/answers"
    },
    {
      "source": "/api/digital-check/:id/complete",
      "destination": "/api/_bridge?__route=/api/digital-check/:id/complete"
    },
    {
      "source": "/api/digital-check/:id",
      "destination": "/api/_bridge?__route=/api/digital-check/:id"
    },
    {
      "source": "/api/digital-check",
      "destination": "/api/_bridge?__route=/api/digital-check"
    },
    {
      "source": "/api/leads",
      "destination": "/api/_bridge?__route=/api/leads"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/_bridge?__route=/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(hero-nex-640.webp|hero-nex-1440.webp|nex-standing-320.webp|nex-standing-640.webp|og-image.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
